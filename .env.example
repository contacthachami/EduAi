# Base de données
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=eduai_db

# Modèles (cache local pour éviter re-téléchargement)
HF_HOME=./models_cache
TRANSFORMERS_CACHE=./models_cache

# Pipeline NLP
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=3
MIN_CONFIDENCE_SCORE=0.25

# Sécurité
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Limites
MAX_PDF_SIZE_MB=50
MAX_COURSES_PER_USER=20
