# Copy these values into Portainer Stack > Environment variables.
# Do not commit real secrets.

# Public frontend URL used for backend CORS.
# Example with Nginx Proxy Manager: https://eduai.example.com
ALLOWED_ORIGINS=https://your-domain.example.com,http://localhost:3000,http://127.0.0.1:3000

# Host ports. MongoDB is intentionally not published.
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=3000
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000

# MongoDB auth. If the Mongo volume already exists, changing these later will
# not rotate the existing Mongo user automatically.
MONGODB_DB_NAME=eduai_db
MONGO_ROOT_USERNAME=eduai_admin
MONGO_ROOT_PASSWORD=change-this-long-mongo-password

# App security.
SECRET_KEY=change-this-long-random-secret

# Hugging Face cache behavior. Keep 0 for the first deployment so models can be
# downloaded into the eduai_models_cache volume, then you may set both to 1.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# LLM backend: groq is easiest for a VPS; ollama requires an Ollama service.
ENABLE_LLM=true
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=http://host.docker.internal:11434

# Optional image names for docker-compose.portainer.images.yml.
EDUAI_BACKEND_IMAGE=your-dockerhub-user/eduai-backend:latest
EDUAI_FRONTEND_IMAGE=your-dockerhub-user/eduai-frontend:latest

# Application limits.
MAX_PDF_SIZE_MB=50
MAX_COURSES_PER_USER=20
