@startuml EduAI_Sequence_S1_Auth
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor        #2E86C1
  ActorBorderColor  #1E8449
  ActorBackgroundColor #D5F5E3
  ParticipantBorderColor  #2E86C1
  ParticipantBackgroundColor #E8F4FD
  LifeLineBorderColor #B0C4DE
  LifeLineBackgroundColor #EBF5FB
  NoteBackgroundColor #FEF9E7
  NoteBorderColor   #D4AC0D
}

title **EduAI — Séquence S1/8 · Authentification**\n(Inscription · Connexion · Restauration de session)

actor      "Étudiant"          as User
participant "Frontend\n(Next.js)"     as FE
participant "Backend\n(FastAPI)"      as BE
participant "bcrypt\n(≥3.0,<4.0)"    as BCR
participant "JWT\n(HS256 · 7j)"      as JWT
database   "MongoDB\n(users)"        as DB

autonumber

' ─────────────────────────────────────────────────────────────
== S1.1 — Inscription   POST /api/auth/register ==
' ─────────────────────────────────────────────────────────────

User -> FE  : Remplit formulaire\n(nom, email, mot de passe)
FE   -> BE  : POST /api/auth/register\n{ name, email, password }
activate BE

BE -> DB : findOne({ email })
activate DB
DB --> BE : résultat
deactivate DB

alt email déjà enregistré
  BE --> FE : 400 "Email déjà utilisé"
  FE --> User : ⚠ Message d'erreur
else email disponible
  BE -> BCR : hash(password[:72])
  activate BCR
  note right of BCR : Salage auto (12 rounds)\nTroncature à 72 octets
  BCR --> BE : password_hash
  deactivate BCR

  BE -> DB : insertOne({ name, email, password_hash })
  activate DB
  DB --> BE : user_id (ObjectId)
  deactivate DB

  BE -> JWT : create_access_token(user_id, exp=7j)
  activate JWT
  JWT --> BE : token (HS256)
  deactivate JWT

  BE --> FE : 201 { token, user }
  deactivate BE

  FE -> FE : localStorage.setItem("eduai_token", token)
  FE --> User : Redirige → /courses
end

' ─────────────────────────────────────────────────────────────
== S1.2 — Connexion   POST /api/auth/login ==
' ─────────────────────────────────────────────────────────────

User -> FE : Saisit email + mot de passe
FE   -> BE : POST /api/auth/login\n{ email, password }
activate BE

BE -> DB : findOne({ email: email.lower() })
activate DB
DB --> BE : user_doc (ou null)
deactivate DB

alt utilisateur introuvable
  BE --> FE : 401 Unauthorized
  FE --> User : ⚠ Identifiants incorrects
else utilisateur trouvé
  BE -> BCR : verify(password[:72], password_hash)
  activate BCR
  BCR --> BE : bool
  deactivate BCR

  alt mot de passe invalide
    BE --> FE : 401 Unauthorized
    FE --> User : ⚠ Identifiants incorrects
  else mot de passe valide
    BE -> JWT : create_access_token(user_id)
    activate JWT
    JWT --> BE : token (HS256)
    deactivate JWT

    BE --> FE : 200 { token, user }
    deactivate BE

    FE -> FE : localStorage.setItem("eduai_token", token)
    FE --> User : Accès à l'application
  end
end

' ─────────────────────────────────────────────────────────────
== S1.3 — Restauration de session   GET /api/auth/me ==
' ─────────────────────────────────────────────────────────────

note over FE : Au démarrage de l'app :\nuseAuth.loadFromStorage() est appelé

FE -> BE : GET /api/auth/me\nAuthorization: Bearer <token>
activate BE

BE -> JWT : verify_token(token)
activate JWT
JWT --> BE : payload { user_id }  /OU/  JWTError
deactivate JWT

alt token expiré ou invalide
  BE --> FE : 401 Unauthorized
  deactivate BE
  FE -> FE : Supprime token (localStorage)
  FE --> User : Redirige → /login
else token valide
  BE -> DB : findOne({ _id: user_id })
  activate DB
  DB --> BE : { id, name, email, plan }
  deactivate DB
  BE --> FE : 200 { id, name, email, plan }
  deactivate BE
  FE --> User : Interface chargée (session restaurée)
end

@enduml
