@startuml EduAI_Sequence_S3_QA
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor        #2E86C1
  ActorBorderColor  #1E8449
  ActorBackgroundColor #D5F5E3
  ParticipantBorderColor  #2E86C1
  ParticipantBackgroundColor #E8F4FD
  LifeLineBorderColor #B0C4DE
  LifeLineBackgroundColor #EBF5FB
  NoteBackgroundColor #FEF9E7
  NoteBorderColor   #D4AC0D
}

title **EduAI — Séquence S3/8 · Questions-Réponses RAG**\n(Streaming SSE · MiniLM + FAISS · Groq LLM · Fallback CamemBERT)

actor      "Étudiant"               as User
participant "ChatInterface\n(Frontend)"    as FE
participant "Backend\n(FastAPI / qa)"      as BE
participant "MiniLM\n(Embedder 384-d)"     as EMB
participant "FAISS\n(IndexFlatIP)"         as FAISS
participant "Groq LLM\n(llama-3.3-70b)"   as LLM
participant "CamemBERT\n(QA extractif)"   as CAM
database   "MongoDB\n(qa_exchanges)"       as DB

autonumber

' ─────────────────────────────────────────────────────────────
== S3.1 — Question en streaming SSE   POST /api/qa/ask/stream ==
' ─────────────────────────────────────────────────────────────

User -> FE  : Saisit une question et envoie
FE   -> BE  : POST /api/qa/ask/stream\n{ course_id, question, session_id? }
note right of FE : Connexion SSE (EventSource)\nflux de tokens temps réel
activate BE

BE -> EMB   : encode(question)
activate EMB
note right of EMB : paraphrase-multilingual-\nMiniLM-L12-v2 · 384-d
EMB --> BE  : query_vector (float32)
deactivate EMB

BE -> FAISS : search(query_vector, top_k=5)
activate FAISS
note right of FAISS : IndexFlatIP\nSeuil de similarité : 0.30
FAISS --> BE : [(chunk_text, score)]
deactivate FAISS

alt Score max < 0.30  (hors-sujet / hors-corpus)
  BE --> FE  : event: error\n"Aucun passage pertinent trouvé"
  deactivate BE
  FE --> User : ⚠ Réponse hors-cours affichée

else Passages pertinents trouvés (score ≥ 0.30)
  BE -> DB   : get_history(session_id, last=3)
  activate DB
  note right of DB : 3 derniers échanges injectés\ndans le contexte du prompt
  DB --> BE  : qa_history[]
  deactivate DB

  note right of BE : Prompt RAG assemblé :\n• System : rôle enseignant\n• Context : chunks top-k\n• History : 3 échanges\n• User : question

  BE -> LLM  : chat.completions.create(stream=True, prompt)
  activate LLM

  alt LLM disponible (Groq Cloud)
    loop Streaming des tokens
      LLM --> BE : delta.content (token)
      BE  --> FE : event: token\ndata: { text }
      FE  -> FE  : Append token (effet typewriter)
    end
    LLM --> BE  : [DONE]
    deactivate LLM
    BE  --> FE  : event: done\n{ sources[], session_id, confidence }

  else LLM indisponible (timeout / quota)
    deactivate LLM
    ' ── Fallback extractif ────────────────────────────────
    == S3.2 — Fallback extractif   CamemBERT ==
    note over BE : Groq LLM injoignable\nActivation du fallback CamemBERT
    BE -> CAM  : answer(question, context=chunks_text)
    activate CAM
    note right of CAM : camembert-base-squadFR\n+ fquad + piaf\nExtraction de span QA
    CAM --> BE : { answer, score }
    deactivate CAM
    BE --> FE  : event: done\n{ answer, sources, llm_used=false }
  end

  BE -> DB   : save_qa_exchange(\nsession_id, question, answer, sources)
  activate DB
  DB --> BE  : ok
  deactivate DB
  deactivate BE

  FE --> User : Réponse complète + sources affichées
  note right of FE : Sources : [{title, page, score}]\nConfidence score visible
end

@enduml
