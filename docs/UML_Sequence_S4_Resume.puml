@startuml EduAI_Sequence_S4_Resume
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor        #2E86C1
  ActorBorderColor  #1E8449
  ActorBackgroundColor #D5F5E3
  ParticipantBorderColor  #2E86C1
  ParticipantBackgroundColor #E8F4FD
  LifeLineBorderColor #B0C4DE
  LifeLineBackgroundColor #EBF5FB
  NoteBackgroundColor #FEF9E7
  NoteBorderColor   #D4AC0D
}

title **EduAI — Séquence S4/8 · Résumé Pédagogique & Export PDF**\n(spaCy · TextRank · Groq LLM · Cache MongoDB · Export PDF)

actor      "Étudiant"             as User
participant "Frontend\n(Next.js)"       as FE
participant "Backend\n(FastAPI / summary)" as BE
participant "spaCy\n(fr_core_news_lg)"  as NLP
participant "TextRank\n(Extractif)"     as TR
participant "Groq LLM\n(llama-3.3-70b)" as LLM
database   "MongoDB"                    as DB

autonumber

' ─────────────────────────────────────────────────────────────
== S4.1 — Génération résumé — cache MISS   GET /api/summary/{id} ==
' ─────────────────────────────────────────────────────────────

User -> FE  : Clique onglet "Synthèse"
FE   -> BE  : GET /api/summary/{course_id}  [Bearer JWT]
activate BE

BE -> DB    : get_cached_summary(course_id)
activate DB
DB --> BE   : null  (pas de cache)
deactivate DB

BE -> DB    : find_chunks({ course_id })
activate DB
DB --> BE   : chunks[]  (texte brut)
deactivate DB

BE -> NLP   : analyze(text)
activate NLP
note right of NLP : spaCy fr_core_news_lg :\n• Tokenisation\n• NER (entités nommées)\n• POS tagging\n• Lemmatisation
NLP --> BE  : doc (annotations linguistiques)
deactivate NLP

BE -> TR    : extract_key_sentences(doc)
activate TR
note right of TR : TextRank extractif :\nsélectionne les phrases\nles plus représentatives
TR --> BE   : extractive_summary (sentences[])
deactivate TR

BE -> LLM   : refine_chapter(\nextractive_summary,\ninstructions=pédagogique)
activate LLM
note right of LLM : Génère une fiche structurée\npar chapitre : titre, points-clés,\nexemples, définitions
LLM --> BE  : structured_summary (markdown)
deactivate LLM

BE -> DB    : cache_summary(course_id, structured_summary)
activate DB
DB --> BE   : ok
deactivate DB

BE --> FE   : 200 { summary: { chapters[], key_points[], ... } }
deactivate BE

FE --> User : Affiche fiche pédagogique formatée

' ─────────────────────────────────────────────────────────────
== S4.2 — Génération résumé — cache HIT   GET /api/summary/{id} ==
' ─────────────────────────────────────────────────────────────

note over User : L'étudiant revient sur l'onglet "Synthèse"\nou recharge la page

User -> FE  : Onglet "Synthèse" (re-visite)
FE   -> BE  : GET /api/summary/{course_id}  [Bearer JWT]
activate BE

BE -> DB    : get_cached_summary(course_id)
activate DB
DB --> BE   : structured_summary (depuis cache)
deactivate DB

note right of BE : Résultat servi directement\nsans appel LLM (instantané)

BE --> FE   : 200 { summary }
deactivate BE
FE --> User : Fiche pédagogique chargée instantanément

' ─────────────────────────────────────────────────────────────
== S4.3 — Export PDF   GET /api/export/summary/{id} ==
' ─────────────────────────────────────────────────────────────

User -> FE  : Clique "Export PDF"\n(bouton Download sur la page cours)
FE   -> BE  : GET /api/export/summary/{course_id}  [Bearer JWT]
activate BE

BE -> DB    : get_cached_summary(course_id)
activate DB
DB --> BE   : structured_summary
deactivate DB

alt Résumé non encore généré
  BE --> FE : 404 "Résumé non disponible"
  FE --> User : ⚠ "Générez d'abord le résumé"
else Résumé disponible
  BE -> BE   : generate_pdf(summary)
  note right of BE : Mise en page PDF :\ntitres, points-clés, sections
  BE --> FE  : 200 application/pdf (binary blob)\nContent-Disposition: attachment;\nfilename="resume_{id}.pdf"
  deactivate BE

  FE -> FE   : URL.createObjectURL(blob)\n→ <a download>.click()
  FE --> User : Fichier PDF téléchargé
end

@enduml
