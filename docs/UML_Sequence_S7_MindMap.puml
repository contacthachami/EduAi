@startuml EduAI_Sequence_S7_MindMap
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor        #2E86C1
  ActorBorderColor  #1E8449
  ActorBackgroundColor #D5F5E3
  ParticipantBorderColor  #2E86C1
  ParticipantBackgroundColor #E8F4FD
  LifeLineBorderColor #B0C4DE
  LifeLineBackgroundColor #EBF5FB
  NoteBackgroundColor #FEF9E7
  NoteBorderColor   #D4AC0D
}

title **EduAI — Séquence S7/8 · Carte Mentale (Mind Map)**\n(Génération Groq LLM · Graphe nodes/edges · Cache MongoDB)

actor      "Étudiant"                as User
participant "Frontend\n(MindMap Page)"     as FE
participant "Backend\n(FastAPI / mindmap)" as BE
participant "Groq LLM\n(llama-3.3-70b)"   as LLM
database   "MongoDB"                       as DB

autonumber

' ─────────────────────────────────────────────────────────────
== S7.1 — Génération du mind map — cache MISS   GET /api/mindmap/{id} ==
' ─────────────────────────────────────────────────────────────

User -> FE  : Clique "Carte mentale"
FE   -> BE  : GET /api/mindmap/{course_id}  [Bearer JWT]
activate BE

BE -> DB    : get_cached_mindmap(course_id)
activate DB
DB --> BE   : null  (pas de cache)
deactivate DB

BE -> DB    : find_chunks({ course_id })
activate DB
DB --> BE   : chunks[]  (texte du cours)
deactivate DB

BE -> LLM   : build_mindmap(chunks)
activate LLM
note right of LLM : Prompt demande un graphe JSON :\nnodes : [{id, label, type}]\nedges : [{source, target, label}]\ntype ∈ { concept | chapter | detail }
LLM --> BE  : { nodes[], edges[] }  (JSON)
deactivate LLM

BE -> BE    : Valide le graphe (Pydantic)\net nœud racine = titre du cours

BE -> DB    : cache_mindmap(course_id, { nodes, edges })
activate DB
DB --> BE   : ok
deactivate DB

BE --> FE   : 200 { nodes[], edges[] }
deactivate BE

FE -> FE    : Rendu React Flow\n(graphe interactif drag & zoom)
FE --> User : Carte mentale interactive affichée

note right of FE : Légende des types :\n• chapter  = nœud chapitre (bleu)\n• concept  = nœud concept  (vert)\n• detail   = nœud détail   (gris)

' ─────────────────────────────────────────────────────────────
== S7.2 — Génération du mind map — cache HIT   GET /api/mindmap/{id} ==
' ─────────────────────────────────────────────────────────────

note over User : L'étudiant revient sur la page\nou recharge le mind map

User -> FE  : Retour sur la carte mentale
FE   -> BE  : GET /api/mindmap/{course_id}  [Bearer JWT]
activate BE

BE -> DB    : get_cached_mindmap(course_id)
activate DB
DB --> BE   : { nodes[], edges[] }  (depuis cache)
deactivate DB

note right of BE : Pas d'appel LLM\n(chargement instantané)

BE --> FE   : 200 { nodes[], edges[] }
deactivate BE

FE -> FE    : Rendu React Flow
FE --> User : Carte mentale chargée instantanément

@enduml
