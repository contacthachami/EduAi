@startuml EduAI_Sequence_S8_Examen
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor        #2E86C1
  ActorBorderColor  #1E8449
  ActorBackgroundColor #D5F5E3
  ParticipantBorderColor  #2E86C1
  ParticipantBackgroundColor #E8F4FD
  LifeLineBorderColor #B0C4DE
  LifeLineBackgroundColor #EBF5FB
  NoteBackgroundColor #FEF9E7
  NoteBorderColor   #D4AC0D
}

title **EduAI — Séquence S8/8 · Examen Simulé**\n(Configuration · Démarrage LLM · Chronomètre · Soumission · Notation)

actor      "Étudiant"              as User
participant "Frontend\n(ExamPage)"      as FE
participant "Backend\n(FastAPI / exam)" as BE
participant "Groq LLM\n(llama-3.3-70b)" as LLM
database   "MongoDB\n(exam_sessions)"   as DB

autonumber

' ─────────────────────────────────────────────────────────────
== S8.1 — Configuration de l'examen ==
' ─────────────────────────────────────────────────────────────

User -> FE  : Ouvre la page /exam
FE  --> User : Affiche panneau de configuration\n(sliders)

User -> FE  : Choisit num_questions (5–40)\net time_limit (5–60 min)

' ─────────────────────────────────────────────────────────────
== S8.2 — Démarrage de l'examen   POST /api/exam/start ==
' ─────────────────────────────────────────────────────────────

User -> FE  : Clique "Commencer l'examen"
FE   -> BE  : POST /api/exam/start\n{ course_id, num_questions,\n  time_limit_minutes }  [Bearer JWT]
activate BE

BE -> DB    : find_chunks({ course_id })
activate DB
DB --> BE   : chunks[]
deactivate DB

BE -> LLM   : generate_exam_questions(\nchunks, num_questions)
activate LLM
note right of LLM : Format JSON :\n[{ id, question, options[4] }]\n⚠ correct_index NON envoyé\nau client (anti-triche)
LLM --> BE  : questions[]  (sans réponses)
deactivate LLM

BE -> DB    : insertOne(exam_session) :\n{ user_id, course_id,\n  questions[], correct_indexes[],\n  time_limit_minutes, status="started" }
activate DB
DB --> BE   : exam_id
deactivate DB

BE --> FE   : 200 { exam_id, questions[] }
deactivate BE

FE -> FE    : Démarre le chronomètre\n(setInterval · time_limit × 60 s)
FE --> User : QCM affiché en mode examen\n(sans correction visible)

' ─────────────────────────────────────────────────────────────
== S8.3 — Passage de l'examen (chronomètre) ==
' ─────────────────────────────────────────────────────────────

note over FE : setInterval décrémente timeLeft chaque seconde\nSi timeLeft = 0 → soumission automatique

loop L'étudiant répond aux questions
  User -> FE  : Sélectionne une option pour Q[i]
  FE  -> FE   : setAnswers({ ...answers, [q.id]: optionIndex })
end

note over FE : Bouton "Terminer" actif dès le début\nou soumission auto à expiration du timer

' ─────────────────────────────────────────────────────────────
== S8.4 — Soumission et notation   POST /api/exam/submit ==
' ─────────────────────────────────────────────────────────────

User -> FE  : Clique "Terminer"\n(ou timer = 0)
FE   -> BE  : POST /api/exam/submit\n{ exam_id,\n  answers: [int],\n  time_spent_seconds }  [Bearer JWT]
activate BE

BE -> DB    : findOne({ _id: exam_id, user_id })
activate DB
DB --> BE   : { questions[], correct_indexes[],\n  time_limit_minutes }
deactivate DB

BE -> BE    : Calcul du score :\nscore  = Σ(answers[i] == correct[i])\ntotal  = len(questions)\npct    = score / total × 100\n\nNotation :\n  A : pct ≥ 90\n  B : pct ≥ 80\n  C : pct ≥ 70\n  D : pct ≥ 60\n  F : pct  < 60\n\npassed = pct ≥ 60

BE -> DB    : updateOne(exam_id,\n{ score, grade, percentage,\n  passed, time_spent_seconds,\n  status="completed" })
activate DB
DB --> BE   : ok
deactivate DB

BE --> FE   : 200 {\n  score, total, percentage,\n  grade, passed,\n  time_spent_seconds\n}
deactivate BE

FE --> User : Écran résultat :\n• Note en couleur (A–F)\n• Score / total\n• Pourcentage\n• Statut : Réussi / Non réussi

note right of FE : Boutons disponibles :\n• "Repasser" → retour config\n• "Retour au cours" → /course/{id}

@enduml
