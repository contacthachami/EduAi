@startuml EduAI_Sequence_Summary
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2E86C1
  ActorBorderColor #1E8449
  LifeLineBorderColor #2E86C1
  LifeLineBackgroundColor #EBF5FB
  ParticipantBorderColor #2E86C1
  ParticipantBackgroundColor #EBF5FB
  ParticipantFontSize 12
  ParticipantFontName Arial
  NoteBackgroundColor #FEF9E7
  NoteBorderColor #D4AC0D
}
skinparam actor {
  BorderColor #1E8449
  BackgroundColor #D5F5E3
}

title **EduAI — Séquence 4 : Génération de Résumé Pédagogique**

actor "Étudiant" as Student
participant "Next.js\nFrontend" as Frontend
participant "FastAPI\nBackend\n(summary router)" as Backend
participant "spaCy NLP\n(fr_core_news_lg)" as Spacy
participant "Summarizer\n(TextRank)" as TextRank
participant "FAISS\nRetriever" as FAISS
participant "LLM Summarizer\n(Groq llama-3.3-70b)" as LLM
database "MongoDB\n(summaries cache)" as DB

Student -> Frontend : Clique sur "Résumé"\nd'un cours
activate Frontend

Frontend -> Backend : GET /api/summary/{course_id}\n[Authorization: Bearer JWT]
activate Backend

Backend -> Backend : Valide JWT

== Vérification du cache ==

Backend -> DB : get_cached_summary(course_id)
activate DB
DB --> Backend : summary_doc (ou null)
deactivate DB

alt Résumé en cache (déjà généré)
  Backend --> Frontend : 200 OK\nSummaryResponse (depuis cache)
  note over Backend : Réponse instantanée\n(pré-généré lors de l'upload)
else Résumé absent ou invalidé
  Backend -> DB : get_chunks_by_course(course_id)
  activate DB
  DB --> Backend : chunks[] [{text, page, chapter}]
  deactivate DB

  Backend -> Backend : Marque cours en génération\n(_generating set)

  == Étape 1 : Analyse NLP par chapitre ==

  Backend -> Spacy : analyser chaque chapitre\n(tokenisation, POS, NER, lemmatisation)
  activate Spacy
  note right of Spacy : spaCy fr_core_news_lg\n- Entités nommées\n- Concepts clés (noms propres,\n  termes techniques)\n- Scoring TF-IDF
  Spacy --> Backend : {key_concepts[], entities[], scored_sentences[]}
  deactivate Spacy

  == Étape 2 : Résumé extractif (TextRank) ==

  Backend -> TextRank : summarize_course(chunks, spacy_analysis)
  activate TextRank
  note right of TextRank : Graph-based ranking\n(similitude cosine entre phrases)\nSélection top-N phrases\npar chapitre
  TextRank --> Backend : chapter_summaries[]\n[{title, summary_extractif, pages, key_concepts}]
  deactivate TextRank

  == Étape 3 : Enrichissement LLM (fiche pédagogique) ==

  loop Pour chaque chapitre
    alt LLM activé (ENABLE_LLM=true)
      Backend -> LLM : refine_chapter(\n  chapter_title,\n  extractive_summary,\n  key_concepts\n)
      activate LLM
      note right of LLM : Prompt structuré:\n- Reformulation pédagogique\n- Titre accrocheur\n- Corps narratif\n- Concepts clés\n- Objectifs d'apprentissage
      LLM --> Backend : {pedagogic: str (Markdown), llm_used: true}
      deactivate LLM
    else LLM désactivé / indisponible
      Backend -> Backend : pedagogic = résumé extractif\nllm_used = false
    end
  end

  == Étape 4 : Métadonnées pipeline ==

  Backend -> Backend : build_pipeline_meta(any_llm)\n[Extraction → spaCy → MiniLM →\nFAISS → TextRank → Groq LLM]

  == Étape 5 : Mise en cache ==

  Backend -> DB : save_cached_summary(course_id, summary_doc)
  activate DB
  DB --> Backend : OK
  deactivate DB

  Backend --> Frontend : 200 OK\nSummaryResponse {\n  chapters: [{title, summary, pedagogic, key_concepts,\n              llm_used, techniques, pages}],\n  pipeline_meta: {steps[], llm_backend, llm_model}\n}
end

deactivate Backend

Frontend -> Frontend : Affiche résumé par onglets\n(chapitres)\nBadges pipeline (NLP / DL / LLM)
Frontend --> Student : Lecture du résumé\n+ concepts clés\n+ fiche pédagogique structurée
deactivate Frontend

|||
== Export PDF ==

Student -> Frontend : Clique "Exporter en PDF"
Frontend -> Backend : GET /api/export/summary/{course_id}
activate Backend
Backend -> DB : Récupère résumé depuis cache
activate DB
DB --> Backend : summary_doc
deactivate DB
Backend -> Backend : Génère PDF stylisé\n(ReportLab / fpdf2)
Backend --> Frontend : StreamingResponse\n(application/pdf)
deactivate Backend
Frontend --> Student : Téléchargement PDF\n"resume_<nom_cours>.pdf"

@enduml
