@startuml EduAI_UseCase_Overview
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome

skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #2E86C1
  FontSize 11
  FontName Arial
}
skinparam actor {
  BackgroundColor #D5F5E3
  BorderColor #1E8449
  FontSize 12
  FontName Arial
}
skinparam rectangle {
  BackgroundColor #FDEDEC
  BorderColor #CB4335
  FontSize 14
  FontName Arial Bold
}

title **EduAI — Vue d'Ensemble des Cas d'Utilisation**\n<size:11>(Voir Pages 1–4 pour le détail de chaque domaine)</size>

left to right direction

' ── Acteurs ───────────────────────────────────────────────────
actor "Étudiant\n(Utilisateur)" as Student
actor "Groq LLM\n(llama-3.3-70b)" as LLM #LightBlue
actor "MongoDB" as DB #LightYellow
actor "FAISS\n(Index vectoriel)" as FAISS #LightPink

' ── Frontière du système ──────────────────────────────────────
rectangle "  Système EduAI  " {

  usecase "1. Authentification\n──────────────────────\nRegister · Login · Profil\nJWT HS256 · bcrypt" as P1
  usecase "2. Gestion des Cours\n──────────────────────\nUpload PDF · Extract · Chunk\nEmbed (MiniLM) · FAISS Index" as P2
  usecase "3. Questions-Réponses\n──────────────────────\nRAG conversationnel\nGroq LLM · CamemBERT fallback" as P3
  usecase "4. Résumés Pédagogiques\n──────────────────────\nspaCy NLP · TextRank\nGroq LLM · Export PDF" as P4
  usecase "5. Quiz Interactif\n──────────────────────\nGénération LLM · QCM\nSoumission · Score détaillé" as P5
  usecase "6. Flashcards (SM-2)\n──────────────────────\nGénération LLM\nRévision espacée (SM-2)" as P6
  usecase "7. Mind Map\n──────────────────────\nCarte conceptuelle\ngénérée par LLM" as P7
  usecase "8. Examen Simulé\n──────────────────────\nTimer · Config (5–40 Q)\nScore · Note A–F" as P8

}

' ── Relations Étudiant → domaines ────────────────────────────
Student --> P1
Student --> P2
Student --> P3
Student --> P4
Student --> P5
Student --> P6
Student --> P7
Student --> P8

' ── Relations systèmes externes ──────────────────────────────
P3 --> LLM : réponses RAG
P4 --> LLM : résumés
P5 --> LLM : génère QCM
P6 --> LLM : génère flashcards
P7 --> LLM : génère mind map

P2 --> FAISS : indexation
P3 --> FAISS : recherche sémantique

P1 --> DB
P2 --> DB
P3 --> DB
P4 --> DB
P5 --> DB
P6 --> DB
P7 --> DB
P8 --> DB

@enduml
