@startuml EduAI_UseCase_Page4
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome

skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #2E86C1
  FontSize 11
  FontName Arial
}
skinparam actor {
  BackgroundColor #D5F5E3
  BorderColor #1E8449
  FontSize 12
  FontName Arial
}
skinparam package {
  BackgroundColor #FEF9E7
  BorderColor #D4AC0D
  FontSize 13
  FontName Arial Bold
}
skinparam arrow {
  Color #2E86C1
  FontSize 10
}

title **EduAI — Cas d'Utilisation · Page 4/4**\n**Examen Simulé**

left to right direction

' ── Acteurs ──────────────────────────────────────────────────
actor "Étudiant" as Student
actor "Groq LLM\n(llama-3.3-70b)" as LLM #LightBlue
actor "MongoDB" as DB #LightYellow

' ── Paquet 8 : Examen Simulé ─────────────────────────────────
package "8. Examen Simulé" {
  usecase "Démarrer un examen\n(POST /exam/start)" as UC_ExamStart
  usecase "Configurer l'examen\n(5–40 questions · 5–60 min)" as UC_ExamConfig
  usecase "Passer l'examen\n(chronomètre · sans correction)" as UC_ExamPass
  usecase "Soumettre l'examen\n(POST /exam/submit)" as UC_ExamSubmit
  usecase "Voir score et note\n(A ≥90 · B ≥80 · C ≥70 · D ≥60 · F <60)" as UC_ExamResult
}

' ── Relations Étudiant → UCs ─────────────────────────────────
Student --> UC_ExamStart
Student --> UC_ExamSubmit

' ── Include / Extend ─────────────────────────────────────────
UC_ExamStart  ..> UC_ExamConfig : <<include>>
UC_ExamStart  ..> UC_ExamPass   : <<include>>
UC_ExamStart  --> LLM           : génère questions QCM
UC_ExamSubmit ..> UC_ExamResult : <<include>>

note right of UC_ExamResult
  Grille de notation :
  A : ≥ 90%  — Excellent
  B : ≥ 80%  — Bien
  C : ≥ 70%  — Satisfaisant
  D : ≥ 60%  — Passable
  F : < 60%  — Insuffisant
  Passage : score ≥ 60%
  Temps passé : time_spent_seconds
end note

note right of UC_ExamConfig
  ExamConfig :
  - course_id
  - num_questions (5–40)
  - time_limit_minutes (5–60)
end note

' ── Relations systèmes externes ──────────────────────────────
UC_ExamStart   --> DB : get course chunks\ncreate exam session
UC_ExamSubmit  --> DB : save exam result

@enduml
