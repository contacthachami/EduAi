@startuml MLD_3_Exam_Activite
!theme plain
title MLD 3/3 – Carte Mentale · Examens · Activité · EduAI SaaS
hide methods
hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam entityBackgroundColor #FFFDE7
skinparam entityBorderColor #F9A825

skinparam entity {
  BackgroundColor<<ref>> #ECEFF1
  BorderColor<<ref>> #90A4AE
}

' ═══════════════════════════════════════════════════════
'  RÉFÉRENCES (définies dans MLD 1/3)
' ═══════════════════════════════════════════════════════
entity "users" <<ref>> as U {
  * _id : ObjectId <<PK>>
}

entity "courses" <<ref>> as C {
  * _id : ObjectId <<PK>>
}

' ═══════════════════════════════════════════════════════
'  CARTE MENTALE
' ═══════════════════════════════════════════════════════
entity "mindmaps" as MM {
  * _id       : ObjectId <<PK>>
  --
  * course_id : String <<FK→courses>>
  * user_id   : String <<FK→users>>
  + nodes     : Object[]
  + edges     : Object[]
}

' ═══════════════════════════════════════════════════════
'  EXAMENS
' ═══════════════════════════════════════════════════════
entity "exams" as EX {
  * _id                : ObjectId <<PK>>
  --
  * user_id            : String <<FK→users>>
  * course_id          : String <<FK→courses>>
  + questions          : Object[]
  * time_limit_minutes : Int
  * started_at         : DateTime
  * status             : "in_progress" | "submitted"
  + score              : Int
  + total              : Int
  + percentage         : Float
  + grade              : String (A-F)
  + passed              : Boolean
  + time_spent_seconds  : Int
  + submitted_at        : DateTime
}

entity "exam_sessions" as ES {
  * _id       : ObjectId <<PK>>
  --
  * course_id : String <<FK→courses>>
}

' ═══════════════════════════════════════════════════════
'  ACTIVITÉ UTILISATEUR
' ═══════════════════════════════════════════════════════
entity "study_activity" as SA {
  * _id     : ObjectId <<PK>>
  --
  * user_id : String <<FK→users>>
  * date    : String "YYYY-MM-DD"
  * active  : Boolean
}

' ═══════════════════════════════════════════════════════
'  RELATIONS
' ═══════════════════════════════════════════════════════
U  ||--o{ MM : "visualise"
C  ||--o{ MM : "carte mentale"
U  ||--o{ EX : "passe"
C  ||--o{ EX : "évalue"
C  ||--o{ ES : "exam sessions"
U  ||--o{ SA : "activité journalière"

@enduml
